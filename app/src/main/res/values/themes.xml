<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Looby" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/looby_background</item>
    </style>

    <style name="Theme.Looby.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/looby_primary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_logo</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.Looby</item>
    </style>
</resources>
